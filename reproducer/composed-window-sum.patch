+/// A binary expression whose leaves retain their original aggregation contexts.
+/// In particular, group means are still computed by the existing rolling kernels.
+enum GroupArithmetic {
+    Leaf(usize),
+    Binary(Box<Self>, Operator, Box<Self>),
+}
+
+impl GroupArithmetic {
+    #[recursive::recursive]
+    fn supports(expr: &dyn PhysicalExpr) -> bool {
+        if let Some((left, _, right)) = expr.as_group_arithmetic() {
+            Self::supports(left) && Self::supports(right)
+        } else {
+            expr.is_group_arithmetic_leaf()
+        }
+    }
+
+    #[recursive::recursive]
+    fn prepare<'a>(
+        expr: &dyn PhysicalExpr,
+        df: &DataFrame,
+        groups: &'a GroupPositions,
+        state: &ExecutionState,
+        leaves: &mut Vec<AggregationContext<'a>>,
+    ) -> PolarsResult<Self> {
+        if let Some((left, op, right)) = expr.as_group_arithmetic() {
+            let left = Self::prepare(left, df, groups, state, leaves)?;
+            let right = Self::prepare(right, df, groups, state, leaves)?;
+            Ok(Self::Binary(Box::new(left), op, Box::new(right)))
+        } else {
+            let idx = leaves.len();
+            leaves.push(expr.evaluate_on_groups(df, groups, state)?);
+            Ok(Self::Leaf(idx))
+        }
+    }
+
+    #[recursive::recursive]
+    fn evaluate(&self, leaves: &[Column]) -> PolarsResult<Column> {
+        match self {
+            Self::Leaf(idx) => Ok(leaves[*idx].clone()),
+            Self::Binary(left, op, right) => {
+                binary::apply_operator(&left.evaluate(leaves)?, &right.evaluate(leaves)?, *op)
+            },
+        }
+    }
+}
+
 impl AggregationExpr {
+    /// Avoid materializing all overlapping memberships for expressions such as
+    /// `((x - x.mean()) * (y - y.mean())).sum()`. Only one window's arithmetic
+    /// intermediates are live at a time. Keep other dtypes/group layouts on the
+    /// existing path. Inspect support before evaluating leaves so that falling
+    /// back cannot evaluate a user-defined function twice.
+    fn try_sum_group_arithmetic<'a>(
+        &self,
+        df: &DataFrame,
+        groups: &'a GroupPositions,
+        state: &ExecutionState,
+    ) -> PolarsResult<Option<AggregationContext<'a>>> {
+        let GroupByMethod::Sum { null_on_empty } = self.agg_type.groupby else {
+            return Ok(None);
+        };
+        if !groups.is_overlapping()
+            || self.output_field.dtype() != &DataType::Float64
+            || self.input.as_group_arithmetic().is_none()
+            || !GroupArithmetic::supports(self.input.as_ref())
+        {
+            return Ok(None);
+        }
+
+        let mut leaves = Vec::new();
+        let expr = GroupArithmetic::prepare(self.input.as_ref(), df, groups, state, &mut leaves)?;
+        let mut has_values = false;
+        let mut has_scalar = false;
+        for ac in &mut leaves {
+            match ac.agg_state() {
+                AggState::NotAggregated(_) => {
+                    if !ac.groups().is_same(groups) {
+                        return Ok(None);
+                    }
+                    has_values = true;
+                },
+                AggState::AggregatedScalar(c) if c.len() == groups.len() => has_scalar = true,
+                AggState::LiteralScalar(c) if c.len() == 1 => {},
+                _ => return Ok(None),
+            }
+        }
+        if !(has_values && has_scalar) {
+            return Ok(None);
+        }
+
+        let mut iters: Vec<Box<dyn Iterator<Item = Option<Column>> + '_>> = leaves
+            .iter_mut()
+            .map(|ac| {
+                if matches!(ac.agg_state(), AggState::NotAggregated(_)) {
+                    Box::new(
+                        ac.iter_groups_lazy()
+                            .map(|s| s.map(IntoColumn::into_column)),
+                    ) as Box<dyn Iterator<Item = Option<Column>> + '_>
+                } else {
+                    Box::new(
+                        ac.iter_groups(false)
+                            .map(|s| s.map(|s| s.deep_clone().into_column())),
+                    )
+                }
+            })
+            .collect();
+        let mut values = Vec::with_capacity(iters.len());
+        let mut sums = PrimitiveChunkedBuilder::<Float64Type>::new(
+            self.output_field.name().clone(),
+            groups.len(),
+        );
+        for _ in 0..groups.len() {
+            values.clear();
+            for iter in &mut iters {
+                // These contexts all have exactly the original number of groups.
+                values.push(iter.next().unwrap().unwrap());
+            }
+            let value = expr.evaluate(&values)?;
+            // Use the same non-overlapping slice reduction as the materialized
+            // list path, including its empty/all-null behavior.
+            let ca = value.f64()?;
+            sums.append_option(if null_on_empty && value.null_count() == value.len() {
+                None
+            } else {
+                Some(match ca.len() {
+                    0 => 0.0,
+                    1 => ca.get(0).unwrap_or(0.0),
+                    _ => ca.sum().unwrap_or(0.0),
+                })
+            });
+        }
+        Ok(Some(AggregationContext::from_agg_state(
+            AggregatedScalar(sums.finish().into_column()),
+            Cow::Borrowed(groups),
+        )))
+    }
