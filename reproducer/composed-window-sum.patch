     from polars._typing import ClosedInterval, EngineType, Label, StartBy
 
 
+@pytest.mark.parametrize("engine", ["streaming", "in-memory"])
+@pytest.mark.parametrize("closed", ["left", "right", "both", "none"])
+@pytest.mark.parametrize("period", ["1i", "4i", "20i"])
+@pytest.mark.parametrize("with_nulls", [False, True])
+def test_dynamic_group_by_centered_product_sum(
+    engine: EngineType, closed: ClosedInterval, period: str, with_nulls: bool
+) -> None:
+    # Independent means and len()-1 are deliberate: with unpaired nulls this
+    # formula has different semantics from pairwise-complete covariance.
+    x = [None if with_nulls and i % 5 == 0 else float(i % 7) for i in range(32)]
+    y = [None if with_nulls and i % 7 == 0 else float(i % 11) for i in range(32)]
+    df = pl.DataFrame(
+        {"g": [0] * 16 + [1] * 16, "t": list(range(16)) * 2, "x": x, "y": y}
+    )
+    df = pl.concat([df[:9], df[9:21], df[21:]], rechunk=False)
+    a, b = pl.col("x"), pl.col("y")
+    formula = ((a - a.mean()) * (b - b.mean())).sum() / (pl.len() - 1)
+    groups = df.lazy().group_by_dynamic(
+        "t", every="2i", period=period, group_by="g", closed=closed
+    )
+    result = groups.agg(value=formula).sort("g", "t").collect(engine=engine)
+    windows = groups.agg(a, b).sort("g", "t").collect(engine=engine)
+    expected_values = [
+        pl.DataFrame({"x": x, "y": y}, schema={"x": pl.Float64, "y": pl.Float64})
+        .select(formula)
+        .item()
+        for x, y in windows.select("x", "y").iter_rows()
+    ]
+    expected = windows.select("g", "t").with_columns(
+        pl.Series("value", expected_values, dtype=pl.Float64)
+    )
+    assert_frame_equal(result, expected, rel_tol=1e-13, abs_tol=1e-13)
+
+
+def test_dynamic_group_by_arithmetic_sum_udf_evaluated_once() -> None:
+    calls = []
+
+    def identity(s: pl.Series) -> pl.Series:
+        calls.append(len(s))
+        return s
+
+    df = pl.DataFrame({"t": range(12), "x": [float(i) for i in range(12)]})
+    a = pl.col("x")
+    result = df.group_by_dynamic("t", every="2i", period="4i").agg(
+        ((a.map_batches(identity, return_dtype=pl.Float64) - a.mean()) * a).sum()
+    )
+    assert len(calls) == result.height
+
